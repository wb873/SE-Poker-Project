# Copy to .env and fill in. .env is ignored by git.
PORT=4000
HOST=localhost
DB_URI=
TESTDB_URI=

# Password reset emails (P4). Leave SMTP_USER/SMTP_PASS empty to print emails
# to the server console instead of sending them.
# For Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it (no spaces) as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# MAIL_FROM="Caribbean Stud Poker <yourteam@gmail.com>"
# Where the reset link in the email points (the client's address, without "#/")
APP_URL=http://localhost:5173
